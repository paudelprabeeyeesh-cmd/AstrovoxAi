{
  "short_name": "Astrovox AI",
  "name": "Astrovox AI - Advanced AI Chat Platform",
  "description": "Astrovox AI is an advanced AI-powered chat platform with offline support, push notifications, deep linking, and multi-platform integration.",
  "categories": ["productivity", "developer tools", "utilities"],
  "lang": "en",
  "default_locale": "en",
  "icons": [
    {
      "src": "/icons/icon-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/icons/icon-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "screenshots": [
    {
      "src": "/screenshots/desktop-1.png",
      "sizes": "1280x800",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Astrovox AI Desktop Chat Interface"
    },
    {
      "src": "/screenshots/mobile-1.png",
      "sizes": "375x812",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Astrovox AI Mobile Chat"
    }
  ],
  "short_description": "AI-powered chat with offline sync and multi-platform support",
  "long_description": "Astrovox AI is a production-ready AI chat platform featuring offline sync, push notifications, deep linking, React Native mobile shell, desktop Tauri apps, and extensions for VS Code, JetBrains, Neovim, and browsers.",
  "features": [
    "Offline-first chat with sync queue",
    "Push notifications",
    "Deep linking and share target",
    "React Native mobile shell",
    "Desktop apps for Windows, macOS, and Linux",
    "Browser extensions for Chrome, Firefox, and Safari",
    "VS Code, JetBrains, and Neovim plugins",
    "Cross-platform storage adapter",
    "Platform analytics",
    "PWA install prompt"
  ],
  "keywords": [
    "ai", "chat", "gpt", "assistant", "productivity",
    "offline", "sync", "notifications", "pwa",
    "react native", "tauri", "vscode", "jetbrains", "neovim"
  ],
  "author": "Astrovox Team",
  "publisher": "Astrovox",
  "website": "https://astrovox.ai",
  "support_url": "https://astrovox.ai/support",
  "privacy_policy": "https://astrovox.ai/privacy",
  "license": "MIT",
  "offline_enabled": true,
  "theme_color": "#02040a",
  "background_color": "#02040a",
  "display": "standalone",
  "orientation": "any",
  "scope": "/",
  "start_url": "/",
  "related_applications": [
    {
      "platform": "windows",
      "url": "https://releases.astrovox.ai/windows/latest",
      "id": "ai.astrovox.desktop"
    },
    {
      "platform": "macos",
      "url": "https://releases.astrovox.ai/macos/latest",
      "id": "ai.astrovox.desktop"
    },
    {
      "platform": "linux",
      "url": "https://releases.astrovox.ai/linux/latest",
      "id": "ai.astrovox.desktop"
    }
  ],
  "prefer_related_applications": false,
  "edge_side_panel": {
    "preferred_width": 480
  },
  "file_handlers": [
    {
      "action": "/",
      "accept": {
        "text/plain": [".txt", ".md"],
        "application/json": [".json"]
      }
    }
  ],
  "protocol_handlers": [
    {
      "protocol": "web+astrovox",
      "url": "/?url=%s"
    }
  ],
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "files",
          "accept": ["text/*", "application/json"]
        }
      ]
    }
  }
}
