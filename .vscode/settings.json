{
  // Shared VS Code settings for the AstrovoxAi repository.
  // Keeps formatting and linting behaviour identical across contributors.
  "editor.formatOnSave": true,
  "editor.rulers": [100],
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "python.analysis.typeCheckingMode": "basic",
  "python.defaultInterpreterPath": "${workspaceFolder}/02-Backend/.venv",
  "python.terminal.activateEnvironment": true,
  "python.testing.pytestEnabled": true,
  "python.testing.pytestArgs": ["02-Backend/tests"],
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.codeActionsOnSave": {
      "source.fixAll.ruff": "explicit",
      "source.organizeImports.ruff": "explicit"
    }
  },
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "jupyter.notebookFileRoot": "${workspaceFolder}/notebooks",
  "terminal.integrated.env.linux": {
    "PYTHONPATH": "02-Backend"
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/__pycache__": true,
    "**/.mypy_cache": true,
    "**/.ruff_cache": true,
    "**/.pytest_cache": true,
    "**/.venv": true,
    "**/checkpoints": true
  }
}
