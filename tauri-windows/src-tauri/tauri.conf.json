# Learn more about Tauri configuration at https://tauri.app/guide/
$schema = "../schema.json"

[build]
beforeDevCommand = "npm run dev"
beforeBuildCommand = "npm run build"
devUrl = "http://localhost:5173"

[app]
identifier = "ai.astrovox.desktop"
windows = [
  { title = "Astrovox AI", width = 1200, height = 800, resizable = true, fullscreen = false }
]
security = { csp = null }

[app.security]
csp = null

[app.webview]
devtools = true

[bundle]
active = true
targets = "all"
icon = [
  "icons/32x32.png",
  "icons/128x128.png",
  "icons/128x128@2x.png",
  "icons/icon.icns",
  "icons/icon.ico"
]
category = "DeveloperTool"
shortDescription = "Astrovox AI Desktop"
longDescription = "AI-powered chat assistant desktop application"

[bundle.windows]
certificateThumbprint = null
digestAlgorithm = "sha256"
timestampUrl = "http://timestamp.digicert.com"

[bundle.macos]
 frameworks = []
 minimumSystemVersion = "11.0"
 exceptionDomain = ""

[bundle.linux]
  desktopTemplate = "./astrovox.desktop"

[updater]
active = true
endpoints = [
  "https://releases.astrovox.ai/stable/latest.json",
  "https://releases.astrovox.ai/beta/latest.json",
  "https://releases.astrovox.ai/nightly/latest.json"
]
dialog = true
pubkey = "dW50cnVzdGVkIGNvbW1lbnQ6IG1pa2U6IDNHOThCOUUxMjE0NjMzMUVFNkFDQTMwQTNGMDM4OTM1RkJDQkRFNkQK"
