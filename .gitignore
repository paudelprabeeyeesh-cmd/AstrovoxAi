# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
.next/
out/
.turbo/
target/
*.egg-info/
.eggs/

# Environment / secrets
# .env must never be committed. Keep .env.example as the only tracked
# env file.
.env
.env.*
.envrc
!.env.example

# Python artefacts
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.Python

# Scratch output and temp scripts; these were committed by mistake at some
# point, so they are excluded explicitly rather than left to chance.
test.txt
test_output.txt
*.tmp

# Go build artefacts
*.exe
*.out
*.test
api.exe
/astrovox
bin/

# Test / type-check caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.cache/
.hypothesis/
.tox/

# Coverage
.coverage
.coverage.*
coverage.xml
htmlcov/

# Logs
*.log
logs/
log/

# Databases and local state
*.db
*.sqlite
*.sqlite3
*.duckdb
postgres-data/
redis-data/
celerybeat-schedule*

# Local agent / tooling state
# Kilo plans, agent-manager state and nested worktrees are local only.
.kilo/
.prabeesh/
.opencode/

# Generated local data (chat transcripts and scan reports). These are
# produced by running the app or tooling, not source code.
conversation_history.json
bandit-report.json
eval_results.json
validation_report.json
quick_eval.json
retraining_metrics.jsonl

# Machine-learning artefacts and datasets
# Checkpoints, weights and numpy arrays are large binaries that do not
# belong in version control. Model code and tokenizers stay tracked.
*.pt
*.pth
*.ckpt
*.safetensors
*.bin
*.npy
*.npz
*.parquet
*.arrow
wandb/
checkpoints/
runs/

# OS / editor junk
.DS_Store
Thumbs.db
desktop.ini

# Backups / temp files
*~
*.bak
*.tmp
*.swp
*.swo
.msg.txt

# IDE
.vscode/
.idea/
