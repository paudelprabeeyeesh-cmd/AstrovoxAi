# Compiled source code
################
*.com
*.class
*.dll
*.exe
*.o
*.so

# Packages
##########
# it's better to unpack these files and commit the raw source
# git has its own built in compression methods
*.7z
*.dmg
*.gz
*.iso
*.jar
*.rar
*.tar
*.zip

# Logs and databases
######################
*.log
*.sql
*.sqlite

# OS generated files
######################
.DS_Store
.AppleDouble
.LSOverride

# Thumbnails
._*

# Files that might appear in the root of a volume
.DocumentReels-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent

# Directories potentially ignored on symlinks
/__MACOSX

# Vim
#####
*.swp

# Virtual machine images (VMDK, VHD, VDI)
*.vmdk
*.vhd
*.vdi

# Helm specific
###############
# Ignore the values.yaml files that are examples
# but keep the user supplied values.yaml
vals.yaml
vals.yaml.template

# Ignore chart checksums
.helmignore
Chart.yaml.tpl
values.yaml.tpl

# Ignore backup files
*~
*.bak
*.tmp