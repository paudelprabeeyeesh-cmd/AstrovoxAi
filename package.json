{
  "name": "astrovox-ai",
  "private": true,
  "version": "2.0.0",
  "description": "ASTROVOX PRIME - Advanced AI Chat Platform",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "vite",
    "frontend": "vite",
    "backend": "cd 02-Backend && python -m uvicorn app.main:app --reload --host 0.0.0.0 --port 8000",
    "lint": "eslint src --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "quality:dashboard": "python tools/code-quality/dashboard.py",
    "quality:dead-code": "python tools/code-quality/dead-code-detector.py",
    "quality:circular-deps": "python tools/code-quality/circular-deps-detector.py",
    "quality:duplication": "python tools/code-quality/code-duplication-finder.py",
    "quality:complexity": "python tools/code-quality/complexity-analyzer.py",
    "quality:types": "python tools/code-quality/type-annotation-checker.py",
    "quality:docs": "python tools/code-quality/docstring-coverage-reporter.py",
    "quality:unused-deps": "python tools/code-quality/unused-deps-detector.py",
    "quality:security": "python tools/code-quality/security-lint-rules.py",
    "quality:api-breaking": "python tools/code-quality/api-breaking-change-detector.py",
    "quality:perf": "python tools/code-quality/performance-regression-detector.py",
    "quality:coverage-gaps": "python tools/code-quality/test-coverage-gap-analyzer.py",
    "quality:ownership": "python tools/code-quality/code-ownership-mapper.py",
    "quality:deps-graph": "python tools/code-quality/dependency-graph-visualizer.py",
    "quality:refactor": "python tools/code-quality/refactoring-suggestions.py",
    "test": "vitest run",
    "test:unit": "vitest run --config vitest.unit.config.js",
    "test:integration": "vitest run --config vitest.integration.config.js",
    "test:e2e": "playwright test",
    "test:load": "k6 run tests/load/chat-load-test.js",
    "test:stress": "k6 run tests/stress/chat-stress-test.js",
    "test:chaos": "vitest run tests/chaos",
    "test:security": "vitest run tests/security",
    "test:contract": "vitest run tests/contract",
    "test:visual": "playwright test tests/visual-regression",
    "test:accessibility": "playwright test tests/accessibility",
    "test:ai-eval": "vitest run tests/ai-evals",
    "test:redteam": "vitest run tests/redteam",
    "test:perf": "vitest run tests/performance",
    "test:snapshot": "vitest run tests/snapshot",
    "test:owasp": "vitest run tests/security/owasp-zap.test.ts",
    "test:locust": "locust -f tests/performance/locust-load-test.py --headless -u 100 -r 10 --run-time 2m --host http://localhost:8000",
    "test:all": "npm run test:unit && npm run test:integration && npm run test:e2e && npm run test:security && npm run test:chaos && npm run test:redteam && npm run test:accessibility",
    "docs:dev": "cd docs && python -m http.server 8080",
    "sdk:generate": "openapi-generator generate -i openapi.yaml -g python -o sdk/python && openapi-generator generate -i openapi.yaml -g typescript-axios -o sdk/typescript && openapi-generator generate -i openapi.yaml -g go -o sdk/go && openapi-generator generate -i openapi.yaml -g rust -o sdk/rust"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.108.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "pg": "^8.23.0",
    "react-markdown": "^9.0.1",
    "remark-gfm": "^4.0.0",
    "rehype-katex": "^7.0.0",
    "rehype-highlight": "^7.0.0",
    "shiki": "^1.0.0",
    "mermaid": "^10.6.1",
    "lucide-react": "^0.344.0",
    "framer-motion": "^11.0.0",
    "@radix-ui/react-dialog": "^1.0.5",
    "@radix-ui/react-dropdown-menu": "^2.0.6",
    "@radix-ui/react-tabs": "^1.0.4",
    "@radix-ui/react-tooltip": "^1.0.7",
    "@radix-ui/react-popover": "^1.0.7",
    "@radix-ui/react-slider": "^1.1.2",
    "@radix-ui/react-switch": "^1.0.3",
    "@radix-ui/react-toast": "^1.1.5",
    "zustand": "^4.5.0",
    "react-router-dom": "^6.21.0",
    "@tanstack/react-query": "^5.17.0",
    "date-fns": "^3.3.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "tailwind-merge": "^2.2.0"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "@vitejs/plugin-react": "^4.2.0",
    "eslint": "^8.56.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "typescript": "^5.6.3",
    "vite": "^6.4.3",
    "vitest": "^4.1.11",
    "@vitest/ui": "^1.3.0",
    "@testing-library/react": "^14.2.1",
    "@testing-library/jest-dom": "^6.4.2",
    "@testing-library/user-event": "^14.5.2",
    "jsdom": "^24.0.0",
    "@playwright/test": "^1.41.0",
    "@axe-core/playwright": "^1.3.0",
    "axe-core": "^4.8.4",
    "k6": "^0.0.0"
  }
}
