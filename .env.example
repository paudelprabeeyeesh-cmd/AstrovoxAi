# ============================================================================
# ASTRAVOX AI - ENVIRONMENT CONFIGURATION
# ============================================================================
# This file contains all environment variables required for AstrovoxAi.
# Copy this to .env and fill in your actual values for production.
# WARNING: Never commit .env to version control.
# ============================================================================

# ============================================================================
# FRONTEND CONFIGURATION (Vite)
# ============================================================================

# Supabase Configuration - REQUIRED
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Backend API URL
VITE_API_URL=https://api.astrovox.ai

# ============================================================================
# BACKEND CONFIGURATION (FastAPI / Python)
# ============================================================================

# Supabase Configuration - REQUIRED
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# AI Providers - REQUIRED
OPENAI_API_KEY=sk-your-api-key-here
ANTHROPIC_API_KEY=your_anthropic_key
GOOGLE_GENERATIVEAI_API_KEY=your_gemini_key
GROQ_API_KEY=your_groq_key
MISTRAL_API_KEY=your_mistral_key
HF_API_KEY=your_huggingface_key

# CORS Configuration - REQUIRED for production
ALLOWED_ORIGINS=https://astrovox.ai,https://www.astrovox.ai,https://app.astrovox.ai
FRONTEND_URL=https://astrovox.ai

# Security - REQUIRED for production
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-very-secure_random-key-change-in-production
JWT_SECRET_KEY=your-jwt-secret-key-min-32-chars

# Database Configuration
DATABASE_URL=postgresql://astrovox:password@localhost:5432/astrovox
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=your-redis-password
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-neo4j-password
JAEGER_URL=http://localhost:14268/api/traces
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=astrovox
POSTGRES_USER=astrovox
POSTGRES_PASSWORD=your-postgres-password
DB_POOL_MIN=2
DB_POOL_MAX=20
DB_POOL_TIMEOUT=30

# Backup Configuration
BACKUP_DIR=backups/database
BACKUP_RETENTION_COUNT=30
AUTOMATED_BACKUPS_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *

# Monitoring
LOG_LEVEL=INFO
GRAFANA_PASSWORD=your-secure-grafana-password
SENTRY_DSN=your-sentry-dsn-here
PROMETHEUS_MULTIPROC_DIR=/tmp
ENABLE_METRICS=true
PAGERDUTY_ROUTING_KEY=your-pagerduty-routing-key
PAGERDUTY_API_KEY=your-pagerduty-api-key
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/XXX/XXX

# ============================================================================
# RATE LIMITING & QUOTAS
# ============================================================================

RATE_LIMIT=120/minute
DAILY_AI_LIMIT=50

# ============================================================================
# STORAGE CONFIGURATION
# ============================================================================

STORAGE_ROOT=./storage
USAGE_DB_PATH=./storage/usage.db

# ============================================================================
# DEPLOYMENT CONFIGURATION
# ============================================================================

ENVIRONMENT=production
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
PYTHON_VERSION=3.12.0

# ============================================================================
# OPTIONAL FEATURES
# ============================================================================

ENABLE_TELEMETRY=false
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# ============================================================================
# SECURITY
# ============================================================================

CORS_ALLOW_CREDENTIALS=true
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ============================================================================
# DEVELOPMENT ONLY
# ============================================================================

DEBUG=false
ALLOW_ALL_ORIGINS=false
