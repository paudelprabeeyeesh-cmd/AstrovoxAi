# ============================================================================
# ASTRAVOX AI - ENVIRONMENT CONFIGURATION
# ============================================================================
# This file contains all environment variables required for AstrovoxAi.
# Copy this to .env and fill in your actual values for production.
# ============================================================================

# ============================================================================
# FRONTEND CONFIGURATION (Vite)
# ============================================================================

# Supabase Configuration - REQUIRED
# Get these from your Supabase project settings (https://supabase.com)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Backend API URL
# Used by frontend to communicate with FastAPI backend
# For development: http://localhost:8000
# For production: https://api.yourdomain.com
VITE_API_URL=http://localhost:8000

# ============================================================================
# BACKEND CONFIGURATION (FastAPI / Python)
# ============================================================================

# Supabase Configuration - REQUIRED
# Must match VITE_SUPABASE_URL and VITE_SUPABASE_ANON_KEY
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key

# Supabase Service Role Key - REQUIRED for backend operations
# Get this from Supabase dashboard (Settings > API)
# DANGER: Never expose this in frontend code!
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# OpenAI Configuration - REQUIRED for AI features
# Get API key from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-api-key-here

# Anthropic Configuration (optional)
# Get API key from https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_key

# Google Gemini Configuration (optional)
# Get API key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_key

# Ollama Configuration (optional)
# Base URL for local Ollama server
OLLAMA_BASE_URL=http://localhost:11434

# CORS Configuration
# Comma-separated list of allowed frontend origins
# For development: http://localhost:5173,http://127.0.0.1:5173
# For production: https://yourdomain.com,https://app.yourdomain.com
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend URL for password reset links
# Should be the full URL where frontend is hosted
FRONTEND_URL=http://localhost:5173

# ============================================================================
# LOGGING & MONITORING
# ============================================================================

# Log level for backend logging (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# ============================================================================
# RATE LIMITING & QUOTAS
# ============================================================================

# Rate limit configuration (requests per minute, per IP)
# Format: "NUMBER/minute"
RATE_LIMIT=120/minute

# Daily AI usage quota per user (number of API calls)
DAILY_AI_LIMIT=50

# ============================================================================
# STORAGE CONFIGURATION
# ============================================================================

# Local storage directory for file uploads
# Directory will be created if it doesn't exist
STORAGE_ROOT=./storage

# Usage database path (SQLite)
# Tracks daily usage quotas
USAGE_DB_PATH=./usage.db

# ============================================================================
# DEPLOYMENT CONFIGURATION
# ============================================================================

# Environment type: development, staging, production
ENVIRONMENT=development

# Server host and port
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# Database connection pooling (if not using Supabase)
# DATABASE_POOL_SIZE=20
# DATABASE_POOL_TIMEOUT=30

# ============================================================================
# OPTIONAL FEATURES
# ============================================================================

# Enable/disable telemetry tracking
ENABLE_TELEMETRY=true

# Redis configuration (optional, for caching)
# REDIS_URL=redis://localhost:6379

# Email configuration (optional, for notifications)
# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your-email@gmail.com
# SMTP_PASSWORD=your-app-password

# ============================================================================
# SECURITY
# ============================================================================

# JWT settings (if not using Supabase Auth)
# SECRET_KEY=your-very-secure-random-key-change-in-production
# ALGORITHM=HS256
# ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS allow credentials
CORS_ALLOW_CREDENTIALS=true

# ============================================================================
# DEVELOPMENT ONLY
# ============================================================================

# Debug mode (never enable in production)
DEBUG=false

# Allow CORS from all origins (never enable in production)
ALLOW_ALL_ORIGINS=false


# ============================================================================
# ECOSYSTEM / DEVELOPER PLATFORM (Stage 22)
# ============================================================================

# Directory where plugins are unpacked and managed
ASTROVOX_PLUGINS_DIR=./plugins

# Directory used by plugins for persistent storage
ASTROVOX_PLUGIN_STORAGE=./storage/plugins

# JSONL file used to persist webhook deliveries
ASTROVOX_WEBHOOK_LOG=./storage/webhooks/deliveries.jsonl

# JSONL file used to persist webhook dead-letter entries
ASTROVOX_WEBHOOK_DLQ=./storage/webhooks/dlq.jsonl

# JSONL file used to persist ecosystem audit entries
ASTROVOX_AUDIT_LOG=./storage/ecosystem/audit.jsonl

# 32-byte key (base64) used to encrypt secrets at rest (optional)
# Generate with: python -c "import os,base64;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# ASTROVOX_VAULT_KEY=
