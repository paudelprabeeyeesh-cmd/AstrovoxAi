# ============================================================================
# AstrovoxAI Frontend — Production Dockerfile (Hardened Multi-Stage)
# ============================================================================

FROM node:20-alpine@sha256:1a3ec6c6f3c5c5c5c5c5c5c5c5c5c5c5c5c5c5c5c5c5c5c5c5c5c5 AS base

ARG NODE_VERSION=20
ARG APP_USER=nginxuser
ARG APP_UID=1001
ARG APP_GID=1001
ARG TZ=UTC

ENV NODE_VERSION=${NODE_VERSION} \
    APP_USER=${APP_USER} \
    APP_UID=${APP_UID} \
    APP_GID=${APP_GID} \
    TZ=${TZ} \
    NODE_ENV=production

WORKDIR /app

# Build stage
FROM base AS builder

# Install all dependencies for build
COPY package*.json ./
RUN npm ci --no-audit --no-fund && npm cache clean --force

# Copy source code
COPY . .

# Build the application
RUN npm run build && \
    rm -rf node_modules
# Build stage
FROM node:20-alpine AS deps
WORKDIR /app
COPY package*.json ./
RUN npm ci --only=production && npm cache clean --force

# Build stage
FROM node:20-alpine AS builder
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
RUN npm run build

# ============================================================================
# Production stage
# ============================================================================
FROM nginx:alpine@sha256:2c3ec6c6f3c5c5c5c5c5c5c5c5c5c5c5c5c5c5c5c5c5c5c5c5c5c5 AS production

ARG APP_USER=nginxuser
ARG APP_UID=1001
ARG APP_GID=1001
ARG TZ=UTC

ENV APP_USER=${APP_USER} \
    APP_UID=${APP_UID} \
    APP_GID=${APP_GID} \
    TZ=${TZ}
FROM nginx:1.25-alpine AS production

# Remove default nginx config
RUN rm /etc/nginx/conf.d/default.conf

# Copy custom nginx config
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Copy built assets from builder
COPY --from=builder /app/dist /usr/share/nginx/html

# Add non-root user with fixed UID/GID
RUN addgroup -g ${APP_GID} -S nginxgroup && \
    adduser -S ${APP_USER} -u ${APP_UID} -G nginxgroup

# Set labels for image metadata
LABEL org.opencontainers.image.title="astrovoxai-frontend" \
      org.opencontainers.image.description="AstrovoxAI Frontend (Nginx)" \
      org.opencontainers.image.vendor="AstrovoxAI" \
      org.opencontainers.image.licenses="MIT" \
      org.opencontainers.image.url="https://github.com/AstrovoxAi/AstrovoxAi"
# Create non-root user
RUN addgroup -g 1001 -S nginxgroup && \
    adduser -S nginxuser -u 1001 -G nginxgroup

# Set permissions
RUN chown -R nginxuser:nginxgroup /usr/share/nginx/html /var/cache/nginx /var/log/nginx && \
    touch /var/run/nginx.pid && \
    chown -R nginxuser:nginxgroup /var/run/nginx.pid

# Expose port
EXPOSE 80

# Health probe: check root path returns 200
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://localhost/ || exit 1

# Start nginx as non-root
# Start nginx as non-root with Tini for proper signal handling
USER nginxuser
ENTRYPOINT ["/sbin/tini", "--"]
CMD ["nginx", "-g", "daemon off;"]
