# ============================================================================
# AstrovoxAI Frontend - Production Dockerfile
# ============================================================================
# Builds the Vite bundle, then serves it from nginx as a non-root user.
#
# Notes:
#   * No image digest is pinned. The previous digest was not a real digest, so
#     the build failed at the very first FROM.
#   * nginx listens on 8080, not 80. Binding a port below 1024 requires
#     CAP_NET_BIND_SERVICE, which this image deliberately does not hold, so
#     "listen 80 + USER nginxuser" fails at startup. The host maps 80 to 8080.
#   * The non-root user is created before USER, and every path nginx writes to
#     is chowned, otherwise nginx cannot create its pid/cache/log files.
#   * TLS is terminated by the edge/load balancer in front of this container,
#     not by nginx here. The compose stack mounted no certificates, so a
#     443 server block could never start. The vhost template takes the
#     listen port from ASTROVOX_HTTP_PORT.
# ============================================================================

ARG NODE_VERSION=20

FROM node:${NODE_VERSION}-alpine AS builder

WORKDIR /app

COPY package*.json ./

RUN npm ci --no-audit --no-fund && npm cache clean --force

COPY . .

RUN npm run build && rm -rf node_modules


# ============================================================================
# Production stage
# ============================================================================
FROM nginx:1.25-alpine

ARG APP_USER=nginxuser
ARG APP_UID=1001
ARG APP_GID=1001

ENV TZ=UTC

# envsubst renders the vhost template at container start.
RUN apk add --no-cache libintl gettext-envsubst

RUN rm -f /etc/nginx/conf.d/default.conf

# The vhost is a template so domains, the backend upstream and the listen port
# come from the environment. The security-headers snippet lives at a fixed path
# so every location can `include` it, which is what makes those headers survive
# on locations that set their own add_header (nginx's add_header inheritance
# silently drops them otherwise).
COPY docker/nginx/nginx.conf.template /etc/nginx/templates/nginx.conf.template
COPY nginx/snippets/security-headers.conf /usr/share/astrovox/security-headers.conf
COPY docker/frontend-entrypoint.sh /usr/local/bin/astrovox-entrypoint

COPY --from=builder /app/dist /usr/share/nginx/html

# nginx needs a writable pid path, cache dir and log dir when not root.
RUN addgroup -g "${APP_GID}" -S nginxgroup \
    && adduser -S -u "${APP_UID}" -G nginxgroup "${APP_USER}" \
    && chmod 755 /usr/local/bin/astrovox-entrypoint \
    && chown -R "${APP_USER}:nginxgroup" /usr/share/nginx/html \
       /var/cache/nginx /var/log/nginx /etc/nginx /etc/nginx/templates \
    && touch /var/run/nginx.pid \
    && chown "${APP_USER}:nginxgroup" /var/run/nginx.pid

LABEL org.opencontainers.image.title="astrovoxai-frontend" \
      org.opencontainers.image.description="AstrovoxAI Frontend (Nginx)" \
      org.opencontainers.image.vendor="AstrovoxAI" \
      org.opencontainers.image.licenses="MIT" \
      org.opencontainers.image.url="https://github.com/AstrovoxAi/AstrovoxAi"

USER ${APP_USER}

# 8080 so a non-root user can bind it without CAP_NET_BIND_SERVICE.
EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://localhost:8080/ || exit 1

# tini is present in alpine only when the `tini` package is installed, which
# this stage does not do, so the previous ENTRYPOINT ["/sbin/tini", "--"]
# failed. The entrypoint renders the template and execs nginx as PID 1.
ENTRYPOINT ["/usr/local/bin/astrovox-entrypoint"]
