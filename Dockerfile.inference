# ============================================================================
# AstrovoxAI Inference Server — Production Dockerfile
# ============================================================================

FROM python:3.12-slim-bookworm@sha256:4a3ec766c3f93b3b6d0c6c6f9c6f3c5c5c5c5c5c5c5c5c5c5c5c5c5c5 AS base

ARG PYTHON_VERSION=3.12
ARG APP_USER=appuser
ARG APP_UID=1000
ARG APP_GID=1000
ARG TZ=UTC

ENV PYTHON_VERSION=${PYTHON_VERSION} \
    APP_USER=${APP_USER} \
    APP_UID=${APP_UID} \
    APP_GID=${APP_GID} \
    TZ=${TZ} \
    DEBIAN_FRONTEND=noninteractive \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    gcc \
    g++ \
    libffi-dev \
    libssl-dev \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt requirements-dev.txt ./
RUN pip install --no-cache-dir --upgrade pip setuptools wheel && \
    pip install --no-cache-dir --prefer-binary -r requirements.txt && \
    pip install --no-cache-dir --prefer-binary -r requirements-dev.txt && \
    rm -rf /root/.cache/pip

FROM base AS production

RUN groupadd -r -g ${APP_GID} ${APP_USER} && \
    useradd -r -g ${APP_USER} -u ${APP_UID} -m -s /usr/sbin/nologin ${APP_USER} && \
    chown -R ${APP_USER}:${APP_USER} /app

LABEL org.opencontainers.image.title="astrovoxai-inference" \
      org.opencontainers.image.description="AstrovoxAI Inference Server" \
      org.opencontainers.image.vendor="AstrovoxAI" \
      org.opencontainers.image.licenses="MIT"

COPY --chown=${APP_USER}:${APP_USER} models/ ./models/
COPY --chown=${APP_USER}:${APP_USER} tokenizer/ ./tokenizer/
COPY --chown=${APP_USER}:${APP_USER} examples/serve_api.py ./

RUN mkdir -p /app/models /app/logs && \
    chown -R ${APP_USER}:${APP_USER} /app/models /app/logs && \
    chmod 750 /app/models /app/logs

USER ${APP_USER}

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -fsS http://localhost:8000/health || exit 1

CMD ["python", "serve_api.py", "--host", "0.0.0.0", "--port", "8000"]
