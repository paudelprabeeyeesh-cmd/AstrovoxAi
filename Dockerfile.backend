# ============================================================================
# AstrovoxAI Backend - Production Dockerfile
# ============================================================================
# Two stages. The builder compiles wheels; the runtime stage ships only what
# the app needs and runs as a non-root user with an init process that reaps
# zombies and forwards SIGTERM.
#
# Notes:
#   * No image digest is pinned. A digest that does not exist makes the build
#     fail on the first FROM, which is untestable and unmergeable. Pin one only
#     after `docker pull` + `docker image inspect` against the real digest.
#   * tini IS installed below. The previous ENTRYPOINT referenced a binary that
#     was never installed, so the container failed to start immediately.
#   * No distroless final stage: distroless has no shell, so the `RUN mkdir`
#     and `/healthcheck-proxy` used here cannot work.
# ============================================================================

ARG PYTHON_VERSION=3.12

FROM python:${PYTHON_VERSION}-slim-bookworm AS builder

WORKDIR /build

RUN apt-get update && apt-get install -y --no-install-recommends \
       gcc \
       g++ \
    && rm -rf /var/lib/apt/lists/*

COPY 02-Backend/requirements.txt ./requirements.txt

RUN pip install --no-cache-dir --upgrade pip setuptools wheel \
    && pip wheel --no-cache-dir --wheel-dir=/wheels -r requirements.txt


# ============================================================================
# Runtime stage
# ============================================================================
FROM python:${PYTHON_VERSION}-slim-bookworm

ARG APP_USER=astrovox
ARG APP_UID=1001
ARG APP_GID=1001

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    TZ=UTC \
    DEBIAN_FRONTEND=noninteractive

# tini provides the init semantics uvicorn needs as PID 1: it reaps
# zombies and forwards SIGTERM so --graceful-timeout actually applies.
RUN apt-get update && apt-get install -y --no-install-recommends \
       ca-certificates \
       curl \
       tini \
    && rm -rf /var/lib/apt/lists/*

# Dedicated, non-login, non-root user.
RUN groupadd -r -g "${APP_GID}" "${APP_USER}" \
    && useradd -r -u "${APP_UID}" -g "${APP_GID}" -m -s /usr/sbin/nologin "${APP_USER}"

WORKDIR /app

# Wheels only - no compiler, no build cache in the runtime image.
COPY --from=builder /wheels /wheels
RUN pip install --no-cache-dir --no-index --find-links=/wheels -r /wheels/requirements.txt \
       python-dateutil 2>/dev/null || pip install --no-cache-dir --no-index --find-links=/wheels \
       $(ls /wheels/*.whl | xargs -n1 basename)

# Write to a directories the non-root user owns, then remove the wheel cache.
RUN mkdir -p /app/logs /app/storage \
    && chown -R "${APP_USER}:${APP_USER}" /app /wheels

COPY --chown=${APP_USER}:${APP_USER} 02-Backend/app ./app
COPY --chown=${APP_USER}:${APP_USER} 02-Backend/scripts ./scripts

USER ${APP_USER}

EXPOSE 8000

LABEL org.opencontainers.image.title="astrovoxai-backend" \
      org.opencontainers.image.description="AstrovoxAI FastAPI Backend" \
      org.opencontainers.image.vendor="AstrovoxAI" \
      org.opencontainers.image.licenses="MIT" \
      org.opencontainers.image.url="https://github.com/AstrovoxAi/AstrovoxAi"

# tini as PID 1, uvicorn as the child that receives the forwarded signal.
ENTRYPOINT ["/usr/bin/tini", "--"]

CMD ["uvicorn", "app.main:app", \
     "--host", "0.0.0.0", \
     "--port", "8000", \
     "--workers", "4", \
     "--graceful-timeout", "30", \
     "--limit-request-line", "8190", \
     "--limit-request-fields", "100", \
     "--limit-request-field-size", "8190", \
     "--log-level", "info"]

HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -fsS http://localhost:8000/health/live || exit 1
